{
    "name": "chubao-win-ai",
    "version": "0.1.0",
    "description": "Windows 本地 AI 自动化控制工具",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "start:all": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start.ps1 -Mode all",
        "start:server": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start.ps1 -Mode server",
        "start:cli": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start.ps1 -Mode cli",
        "dev:parallel": "powershell -ExecutionPolicy Bypass -File .\\scripts\\parallel-dev.ps1",
        "dev:parallel:gpt53": "powershell -ExecutionPolicy Bypass -File .\\scripts\\parallel-dev.ps1 -SingleModel openai/gpt-5.3-codex",
        "dev:parallel:preview": "powershell -ExecutionPolicy Bypass -File .\\scripts\\parallel-dev.ps1 -PreviewOnly",
        "verify": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start.ps1 -Mode verify",
        "verify:static": "powershell -ExecutionPolicy Bypass -File .\\scripts\\smoke.ps1 -StaticOnly",
        "guardrails:check": "powershell -ExecutionPolicy Bypass -File .\\scripts\\repo-guardrails.ps1 -Mode check",
        "guardrails:apply": "powershell -ExecutionPolicy Bypass -File .\\scripts\\repo-guardrails.ps1 -Mode apply",
        "secret:scan": "node ./scripts/secret-scan.mjs --staged",
        "secret:scan:all": "node ./scripts/secret-scan.mjs --all",
        "hooks:install": "git config core.hooksPath .githooks",
        "setup:ocr": "powershell -ExecutionPolicy Bypass -File .\\scripts\\setup-ocr.ps1",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "smoke": "powershell -ExecutionPolicy Bypass -File .\\scripts\\smoke.ps1",
        "test:core": "vitest run src/core src/skills/coding",
        "test:core:watch": "vitest src/core src/skills/coding",
        "test:node-backend": "vitest run sidecars/node-backend/src/agent sidecars/node-backend/src/tools sidecars/node-backend/src/routes sidecars/node-backend/src/gateway sidecars/node-backend/src/channel sidecars/node-backend/src/memory sidecars/node-backend/src/coding",
        "test:node-backend:watch": "vitest sidecars/node-backend/src/agent sidecars/node-backend/src/tools sidecars/node-backend/src/routes sidecars/node-backend/src/gateway sidecars/node-backend/src/channel sidecars/node-backend/src/memory sidecars/node-backend/src/coding",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.0.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@tauri-apps/cli": "^2.0.0",
        "@types/node": "^25.2.3",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "typescript": "^5.4.0",
        "vite": "^5.4.0",
        "vitest": "^2.1.8"
    }
}
