{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chubao AI",
  "version": "0.3.0",
  "identifier": "com.chubao.win-ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chubao AI",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "externalBin": [],
    "resources": {
      "resources/node-sidecar/node.exe": "resources/node-sidecar/node.exe",
      "resources/node-sidecar/node-backend.cjs": "resources/node-sidecar/node-backend.cjs",
      "resources/node-sidecar/node_modules/better-sqlite3/package.json": "resources/node-sidecar/node_modules/better-sqlite3/package.json",
      "resources/node-sidecar/node_modules/better-sqlite3/build/Release/better_sqlite3.node": "resources/node-sidecar/node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "resources/node-sidecar/node_modules/better-sqlite3/lib/*": "resources/node-sidecar/node_modules/better-sqlite3/lib/",
      "resources/node-sidecar/node_modules/bindings/bindings.js": "resources/node-sidecar/node_modules/bindings/bindings.js",
      "resources/node-sidecar/node_modules/bindings/package.json": "resources/node-sidecar/node_modules/bindings/package.json",
      "resources/node-sidecar/node_modules/file-uri-to-path/index.js": "resources/node-sidecar/node_modules/file-uri-to-path/index.js",
      "resources/node-sidecar/node_modules/file-uri-to-path/package.json": "resources/node-sidecar/node_modules/file-uri-to-path/package.json",
      "resources/python-sidecar/python-automation.exe": "resources/python-sidecar/python-automation.exe"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
