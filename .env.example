# Chubao AI 环境变量配置

# Claude API (必需)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# 可选: 自定义 Claude 兼容网关地址（默认 https://api.anthropic.com）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 可选: Claude 模型名（默认 claude-sonnet-4-20250514）
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 服务端口
NODE_PORT=3100
PYTHON_PORT=3200

# ============================================
# 消息平台集成配置
# ============================================

# 飞书 (Lark) 配置
# 1. 访问 https://open.feishu.cn 创建企业自建应用
# 2. 获取 App ID 和 App Secret
# 3. 启用 "机器人" 能力
# 4. 订阅 "消息事件" - im.message.receive_v1
# 5. 配置请求地址: https://your-domain/lark/webhook
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选: 加密密钥 (用于验证 webhook 签名)
LARK_ENCRYPT_KEY=
# 可选: 验证 Token
LARK_VERIFICATION_TOKEN=

# Telegram Bot 配置
# 1. 在 Telegram 中搜索 @BotFather
# 2. 发送 /newbot 创建新机器人
# 3. 获取 Bot Token (格式: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# 4. (可选) 配置 Webhook URL 用于接收消息
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# 可选: Webhook URL (如果不设置则使用 Long Polling)
# TELEGRAM_WEBHOOK_URL=https://your-domain/telegram/webhook
# 可选: 允许访问的用户 ID 列表 (逗号分隔)，不设置则允许所有用户
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# WhatsApp Web 配置
# 注意: WhatsApp 需要扫描 QR 码登录
WHATSAPP_ENABLED=false
# 可选: Session 名称 (用于多账号)
WHATSAPP_SESSION_NAME=chubao-ai
# 可选: 数据存储路径
WHATSAPP_DATA_PATH=./whatsapp-session
# 可选: 是否无头模式 (默认 true)
WHATSAPP_HEADLESS=true
# 可选: 授权号码列表 (逗号分隔)，不设置则允许所有号码
# WHATSAPP_AUTHORIZED_NUMBERS=86138xxxxxxxx,86139xxxxxxxx

# ============================================
# 开发配置
# ============================================

NODE_ENV=development
